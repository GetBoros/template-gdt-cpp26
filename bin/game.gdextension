[configuration]
entry_symbol = "game_library_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]
linux.debug.x86_64 = "res://bin/libgame.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libgame.linux.template_release.x86_64.so"
web.debug.wasm32 = "res://bin/libgame.web.template_debug.wasm32.wasm"
web.release.wasm32 = "res://bin/libgame.web.template_release.wasm32.wasm"